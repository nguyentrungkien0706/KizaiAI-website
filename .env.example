# Tên miền chính thức của website
NEXT_PUBLIC_SITE_URL=https://ai.kizai.vn
# Webhook nhận form đặt demo (xem docs/google-sheet-form.md)
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_SECRET=

# Không bắt buộc (đặt làm build arg trên Dokploy):
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GSC_VERIFICATION=<mã trong thẻ meta google-site-verification>
# NEXT_PUBLIC_BING_VERIFICATION=<mã msvalidate.01>
